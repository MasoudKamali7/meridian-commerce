# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already listed in .gitignore). Never paste a real key into THIS file.

# --- Database (matches Phase 2's meridian_app role) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meridian_commerce
DB_USER=meridian_app
DB_PASSWORD=

# --- LLM provider: OpenRouter (OpenAI-compatible API) ---
# Used by BOTH Phase 3 (classification) and Phase 5 (response drafting).
# Base URL is fixed in code: https://openrouter.ai/api/v1
# Create a free key at https://openrouter.ai/keys and put it in your local
# .env only. Leave it empty here.
OPENROUTER_API_KEY=
# Free routing only. "openrouter/free" picks a free model that supports tool
# calling. Any other value must be a model id ending in ":free"; paid models
# are rejected at startup.
MODEL_NAME=openrouter/free
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
# Total attempts per LLM call (timeouts, 429s, 5xx and malformed tool calls
# are retried; auth errors and other 4xx are not).
LLM_MAX_RETRIES=3

# --- Pipeline behavior ---
DRY_RUN=true
BATCH_SIZE=10

# --- Phase 4: business-rule engine ---
# Thresholds below are data-grounded defaults (see PHASE4_SUMMARY.md) but
# not empirically calibrated — override here if you have better data.
HIGH_VALUE_ORDER_THRESHOLD=450.0
LOW_CONFIDENCE_THRESHOLD=0.75
STRONG_NEGATIVE_SENTIMENT_THRESHOLD=-0.7
RULES_DRY_RUN=true
RULES_BATCH_SIZE=10

# --- Phase 5: response decision layer ---
# Same double-confirmation safety model: RESPONSE_DRY_RUN=false AND --live
# must both be present before any database write.
RESPONSE_DRY_RUN=true
RESPONSE_BATCH_SIZE=10
# Whether to draft internal (agent-reference only, never customer-facing)
# responses for tickets Phase 4 routed to human review.
GENERATE_INTERNAL_DRAFTS=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Cost tracking (optional) ---
# Free routing costs nothing; leave these blank. They exist only so token
# counts could be priced if the project ever changed providers.
INPUT_TOKEN_PRICE_PER_MILLION=
OUTPUT_TOKEN_PRICE_PER_MILLION=
